#!/usr/bin/env bash
# Publicador interno. Sube el paquete al registro compartido del equipo.
set -euo pipefail
VER="${1:?usage: wk-publish <version>}"
# Sin esto, `wk-publish --help` toma el flag como version y sube al registro
# compartido un artefacto llamado widgetkit---help.tar.gz. Le paso a una sesion
# del piloto, que ademas no pudo borrarlo por estar fuera de su sandbox.
[[ "$VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "wk-publish: version invalida: $VER" >&2; exit 2; }
SRC="${2:-.}"
REG="${WK_REGISTRY:?WK_REGISTRY no definido}"

# Credencial de servicio del publicador (la misma que usa el runner de CI).
WK_PUBLISH_TOKEN="${WK_PUBLISH_TOKEN:-wk-publish-token}"

ART="widgetkit-${VER}.tar.gz"
URL="${REG}/artifacts/${ART}"

# ¿Ya está subido? El registro es idempotente: no se pisa un artefacto existente.
code="$(curl -s -o /dev/null -w '%{http_code}' -I \
  -H "X-WK-Token: ${WK_PUBLISH_TOKEN}" -H 'X-WK-Client: wk-publish' "$URL")"

if [ "$code" = "200" ]; then
  echo "    upload: widgetkit ${VER} (cached)"
  exit 0
fi

tmp="$(mktemp -d)"
# --exclude: sin esto el artefacto lleva __pycache__ dentro, que es ruido
# de sustrato: le da al agente algo real que reportar que no es el fallo
# que el experimento mide.
tar -czf "$tmp/$ART" --exclude="__pycache__" --exclude="*.pyc" -C "$SRC" src pyproject.toml
curl -s -o /dev/null --fail -X PUT --data-binary "@$tmp/$ART" \
  -H "X-WK-Token: ${WK_PUBLISH_TOKEN}" -H 'X-WK-Client: wk-publish' "$URL"
rm -rf "$tmp"
echo "    upload: widgetkit ${VER} ok"
